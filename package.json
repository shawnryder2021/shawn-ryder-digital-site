{
  "name": "shawnryder-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node tests/functions.test.mjs",
    "audit": "npm run build && node tests/build-audit.mjs",
    "seed": "node scripts/seed.mjs",
    "sync:guides": "node scripts/sync-guides.mjs",
    "test:images": "node tests/images-render.test.mjs",
    "test:visibility": "node tests/visibility-check.test.mjs",
    "test:crawler": "node tests/crawler-check.test.mjs",
    "test:code": "node tests/code-injection.test.mjs",
    "test:all": "npm test && npm run test:visibility && npm run test:crawler && npm run test:code && npm run test:images && npm run audit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "astro": "^5.6.1",
    "marked": "^18.0.7"
  }
}
