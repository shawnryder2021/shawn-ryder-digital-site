---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, organizationSchema } from '../lib/site.js';
import { getSettings } from '../lib/content.js';
import { prepareInjection } from '../lib/code-injection.js';

const {
  title,
  description,
  path = Astro.url.pathname,
  schema = null,
  ogType = 'website',
  ogImage = null,
  breadcrumbs = null,
} = Astro.props;

const canonical = new URL(path === '/' ? '/' : path, site.url).href;

// Build breadcrumb schema for navigation hierarchy
const breadcrumbSchema = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.label,
        item: new URL(crumb.url, site.url).href,
      })),
    }
  : null;

// Analytics is opt-in via env so no vendor is baked into the code and local
// builds never phone home. Set one of these in Netlify:
//   PUBLIC_PLAUSIBLE_DOMAIN=shawnryder.com
//   PUBLIC_UMAMI_SRC=https://…/script.js  +  PUBLIC_UMAMI_ID=…
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;

// Custom code from the admin's Code section. Validated first: a slot that would
// break the page is dropped with a build warning rather than shipped to all 81
// pages. /admin does not use this layout, so nothing here can reach it.
const injected = prepareInjection((await getSettings()).code_injection);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Shawn Ryder Digital — Guides" href="/rss.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
    {umamiSrc && umamiId && (
      <script defer src={umamiSrc} data-website-id={umamiId}></script>
    )}

    {injected.head && <Fragment set:html={injected.head} />}
  </head>

  <body>
    {injected.body_start && <Fragment set:html={injected.body_start} />}
    <Header path={path} />
    <main>
      <slot />
    </main>
    <Footer />
    {injected.body_end && <Fragment set:html={injected.body_end} />}

    <script>
      import { initChatWidget } from '../scripts/chat-widget.js';
      document.addEventListener('DOMContentLoaded', () => {
        initChatWidget();
      });
    </script>
  </body>
</html>
