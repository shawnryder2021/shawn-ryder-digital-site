---
import { site } from '../lib/site.js';
import { getNav, getSettings } from '../lib/content.js';

const year = new Date().getFullYear();
const settings = await getSettings();
const contact = settings.contact ?? {};
const footerLinks = (await getNav()).footer;

// Group footer links by their column heading, preserving insertion order.
const columns = [];
for (const link of footerLinks) {
  const name = link.group_label || 'Site';
  let col = columns.find((c) => c.name === name);
  if (!col) columns.push((col = { name, links: [] }));
  col.links.push(link);
}
---

<footer>
  <div class="wrap top">
    <div class="about">
      <div class="name">{site.name}</div>
      <p>{settings.footer_blurb}</p>
      <div class="direct">
        <a href={`mailto:${contact.email ?? site.email}`}>{contact.email ?? site.email}</a>
        <a href={contact.phone_href ?? site.phoneHref}>{contact.phone ?? site.phone}</a>
      </div>
    </div>

    <div class="cols">
      {columns.map((col) => (
        <div>
          <div class="head">{col.name}</div>
          {col.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      ))}
    </div>
  </div>

  <div class="bottom">
    <div class="wrap row">
      <span>© {year} {site.name}</span>
      <div class="legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--surface); border-top: 1px solid var(--line-2); margin-top: 8px; }
  .top {
    padding: 56px var(--pad) 44px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px;
  }
  .name { font-family: var(--display); font-weight: 800; font-size: 20px; letter-spacing: -0.02em; margin-bottom: 12px; }
  .about p { font-size: 15.5px; line-height: 1.6; color: var(--ink-3); margin: 0 0 20px; max-width: 46ch; }
  .direct { display: flex; gap: 20px; flex-wrap: wrap; font-weight: 600; font-size: 15px; }

  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .cols > div { display: grid; gap: 9px; align-content: start; }
  .head {
    font-size: 13px; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--faint);
  }
  .cols a { color: var(--ink-2); font-size: 15px; }
  .cols a:hover { color: var(--ink); }

  .bottom { border-top: 1px solid var(--line-2); }
  .row {
    padding-top: 20px; padding-bottom: 20px;
    font-size: 13.5px; color: var(--faint);
    display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  }
  .row a { color: var(--faint); }
  .row a:hover { color: var(--ink); }
  .legal { display: flex; gap: 20px; }

  @media (max-width: 900px) {
    .top { grid-template-columns: minmax(0, 1fr); gap: 36px; }
  }
</style>
