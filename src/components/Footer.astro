---
import { site } from '../lib/site.js';
import { getNav, getSettings } from '../lib/content.js';

const year = new Date().getFullYear();
const settings = await getSettings();
const contact = settings.contact ?? {};
const footerLinks = (await getNav()).footer;

// Group footer links by their column heading, preserving insertion order.
const columns = [];
for (const link of footerLinks) {
  const name = link.group_label || 'Site';
  let col = columns.find((c) => c.name === name);
  if (!col) columns.push((col = { name, links: [] }));
  col.links.push(link);
}
---

<footer>
  <div class="wrap top">
    <div class="about">
      <div class="name"><span class="mark" aria-hidden="true">SR</span>{site.name}</div>
      <p class="where">Halifax, Nova Scotia · Working with dealers across Canada and the U.S.</p>
      <p>{settings.footer_blurb}</p>
      <div class="direct">
        <a href={`mailto:${contact.email ?? site.email}`}>{contact.email ?? site.email}</a>
        <a href={contact.phone_href ?? site.phoneHref}>{contact.phone ?? site.phone}</a>
      </div>
    </div>

    <div class="cols">
      {columns.map((col) => (
        <div>
          <div class="head">{col.name}</div>
          {col.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      ))}
    </div>
  </div>

  <div class="bottom">
    <div class="wrap row">
      <span>© {year} {site.name}</span>
      <div class="legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/sitemap.xml">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--navy); color: var(--on-dark-2); }
  .top {
    padding: 64px var(--pad) 52px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px;
  }
  .name {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--display); font-weight: 700; font-size: 22px; color: #fff; margin-bottom: 8px;
  }
  .mark {
    width: 36px; height: 36px; border-radius: var(--r-sm); background: var(--navy-2);
    border: 1px solid var(--navy-line); box-shadow: inset 0 -3px 0 var(--brand);
    display: grid; place-items: center; font-size: 15px;
  }
  .about .where { font-size: 14.5px; color: var(--on-dark-3); margin: 0 0 18px; }
  .about p { font-size: 16px; line-height: 1.6; color: var(--on-dark-2); margin: 0 0 22px; max-width: 46ch; }
  .direct { display: flex; gap: 22px; flex-wrap: wrap; font-weight: 600; font-size: 16px; }
  .direct a { color: #fff; border-bottom: 1px solid var(--brand); padding-bottom: 2px; }
  .direct a:hover { color: var(--on-dark-accent); }

  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .cols > div { display: grid; gap: 10px; align-content: start; }
  .head {
    font-family: var(--display); font-size: 14px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: #fff; margin-bottom: 4px;
  }
  .cols a { color: var(--on-dark-2); font-size: 15.5px; }
  .cols a:hover { color: #fff; }

  .bottom { border-top: 1px solid var(--navy-line); }
  .row {
    padding-top: 22px; padding-bottom: 22px;
    font-size: 14px; color: var(--on-dark-3);
    display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  }
  .row a { color: var(--on-dark-3); }
  .row a:hover { color: #fff; }
  .legal { display: flex; gap: 20px; }

  @media (max-width: 900px) {
    .top { grid-template-columns: minmax(0, 1fr); gap: 36px; }
  }
</style>
