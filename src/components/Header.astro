---
import { getNav } from '../lib/content.js';

const { path = '/' } = Astro.props;
const nav = (await getNav()).header;

// /markets/halifax should still light up "Markets"; /guides/<slug> lights up
// "Guides". Home only matches exactly.
const isActive = (href) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Shawn Ryder Digital — home">
      <span class="mark" aria-hidden="true">SR</span>
      <span class="name">Shawn Ryder<span class="light">Automotive Digital Marketing</span></span>
    </a>

    <input type="checkbox" id="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Menu"><span></span></label>

    <nav>
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['link', { on: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact" class="cta">Free dealer audit</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .brand { display: flex; align-items: center; gap: 12px; color: inherit; }
  .brand:hover { color: inherit; }
  .mark {
    width: 40px; height: 40px; border-radius: var(--r-sm); background: var(--navy);
    display: grid; place-items: center;
    font-family: var(--display); font-weight: 700; font-size: 17px; letter-spacing: 0.02em;
    color: #fff; box-shadow: inset 0 -3px 0 var(--brand);
  }
  .name {
    display: flex; flex-direction: column; line-height: 1.05;
    font-family: var(--display); font-weight: 700; font-size: 21px; color: var(--ink);
  }
  .light {
    font-weight: 600; font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); margin-top: 3px;
  }

  nav { display: flex; align-items: center; gap: 2px; height: 100%; }
  .link {
    position: relative; display: flex; align-items: center; height: 100%;
    padding: 0 12px;
    font-family: var(--display); font-size: 16.5px; font-weight: 600; color: var(--ink-2);
  }
  .link:hover { color: var(--ink); }
  .link.on { color: var(--ink); }
  .link.on::after {
    content: ''; position: absolute; left: 12px; right: 12px; bottom: -1px;
    height: 3px; background: var(--brand);
  }
  .cta {
    margin-left: 14px; padding: 11px 18px; border-radius: var(--r-sm);
    background: var(--brand); color: #fff;
    font-family: var(--display); font-weight: 600; font-size: 16px; letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .cta:hover { background: var(--brand-dark); color: #fff; }

  .burger { display: none; }

  /* Checkbox toggle — no JS needed for the mobile menu. */
  @media (max-width: 1160px) {
    .burger {
      display: block; width: 26px; height: 20px; position: relative; cursor: pointer;
    }
    .burger span, .burger::before, .burger::after {
      content: ''; position: absolute; left: 0; right: 0; height: 2px;
      background: var(--ink); border-radius: 2px;
    }
    .burger::before { top: 0; }
    .burger span { top: 9px; }
    .burger::after { bottom: 0; }

    nav {
      display: none; height: auto;
      position: absolute; left: 0; right: 0; top: 76px;
      flex-direction: column; align-items: stretch; gap: 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
      padding: 8px var(--pad) 20px;
      box-shadow: var(--shadow-md);
    }
    #nav-toggle:checked ~ nav { display: flex; }
    .link { padding: 14px 4px; font-size: 18px; border-bottom: 1px solid var(--line-2); }
    .link.on::after { left: 0; right: auto; width: 3px; top: 12px; bottom: 12px; height: auto; }
    .link.on { padding-left: 14px; }
    .cta { margin: 16px 0 0; text-align: center; padding: 14px; }
  }
  @media (max-width: 420px) {
    .light { font-size: 10px; letter-spacing: 0.08em; }
  }
</style>
