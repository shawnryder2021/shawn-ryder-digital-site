---
import { nav } from '../lib/site.js';

const { path = '/' } = Astro.props;

// /markets/halifax should still light up "Markets"; /guides/<slug> lights up
// "Guides". Home only matches exactly.
const isActive = (href) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header>
  <div class="wrap bar">
    <a href="/" class="brand">
      <span class="mark">SR</span>
      <span class="name">Shawn Ryder <span class="light">Digital</span></span>
    </a>

    <input type="checkbox" id="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Menu"><span></span></label>

    <nav>
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['link', { on: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact" class="cta">Free audit</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(250, 250, 251, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-2);
  }
  .bar {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .brand { display: flex; align-items: center; gap: 11px; color: inherit; }
  .mark {
    width: 32px; height: 32px; border-radius: 10px; background: var(--brand);
    display: grid; place-items: center;
    font-family: var(--display); font-weight: 800; font-size: 13px;
    color: #fff; letter-spacing: -0.02em;
  }
  .name { font-family: var(--display); font-weight: 800; font-size: 16px; letter-spacing: -0.02em; }
  .light { color: var(--faint); font-weight: 600; }

  nav { display: flex; align-items: center; gap: 6px; }
  .link {
    padding: 8px 14px; border-radius: 999px;
    font-size: 14.5px; font-weight: 600; color: var(--muted);
  }
  .link:hover { color: var(--ink); }
  .link.on { color: var(--ink); background: var(--brand-tint); }
  .cta {
    margin-left: 12px; padding: 11px 20px; border-radius: 999px;
    background: var(--ink); color: #fff;
    font-family: var(--display); font-weight: 700; font-size: 14px;
    box-shadow: 0 8px 20px -10px rgba(11, 13, 18, 0.5);
  }
  .cta:hover { background: var(--brand); color: #fff; }

  .burger { display: none; }

  /* Checkbox toggle — no JS needed for the mobile menu. */
  @media (max-width: 1080px) {
    .burger {
      display: block; width: 26px; height: 20px; position: relative; cursor: pointer;
    }
    .burger span, .burger::before, .burger::after {
      content: ''; position: absolute; left: 0; right: 0; height: 2px;
      background: var(--ink); border-radius: 2px;
    }
    .burger::before { top: 0; }
    .burger span { top: 9px; }
    .burger::after { bottom: 0; }

    nav {
      display: none;
      position: absolute; left: 0; right: 0; top: 72px;
      flex-direction: column; align-items: stretch; gap: 2px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      padding: 12px var(--pad) 20px;
    }
    #nav-toggle:checked ~ nav { display: flex; }
    .link { padding: 12px 14px; font-size: 16px; }
    .cta { margin: 8px 0 0; }
  }
</style>
