---
import Base from '../layouts/Base.astro';
import terms from '../data/glossary.json';
import { site } from '../lib/site.js';

const title = 'Dealership Digital Marketing Glossary — Plain-English Terms';
const description =
  'VDP, speed to lead, local pack, co-op, equity mining and 35 more dealership marketing terms, explained in plain English with links to the guides that go deeper.';

const sorted = [...terms].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const anchor = (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const letters = [...new Set(sorted.map((t) => t.term[0].toUpperCase()))];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Dealership digital marketing glossary',
  url: `${site.url}/glossary`,
  hasDefinedTerm: sorted.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    description: t.def,
    url: `${site.url}/glossary#${anchor(t.term)}`,
  })),
};
---

<Base title={title} description={description} path="/glossary" schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Glossary</div>
      <h1>Dealership marketing, in plain English.</h1>
      <p class="lede">
        Every vendor meeting comes with a new acronym. Here are the ones that matter, in a
        sentence or two each — with a link to the guide that goes deeper where there is one.
      </p>
    </div>
  </section>

  <nav class="wrap letters" aria-label="Jump to letter">
    {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
  </nav>

  <section class="wrap section-tight">
    {letters.map((l) => (
      <div class="group" id={`letter-${l}`}>
        <h2>{l}</h2>
        <dl>
          {sorted.filter((t) => t.term[0].toUpperCase() === l).map((t) => (
            <div id={anchor(t.term)}>
              <dt>{t.term}</dt>
              <dd>
                {t.def}
                {t.link && <> <a href={t.link}>{t.link.startsWith('/guides/') ? 'Read the guide' : 'Learn more'} ›</a></>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </section>

  <section class="cta-strip">
    <div class="wrap">
      <div>
        <h2>Missing a term?</h2>
        <p>If a vendor used a word you didn't recognize, send it over. I'll explain it — and tell you whether it matters for your store.</p>
      </div>
      <a href="/contact" class="btn btn-primary">Ask me</a>
    </div>
  </section>
</Base>

<style>
  .letters { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 28px; }
  .letters a {
    width: 40px; height: 40px; display: grid; place-items: center;
    background: #fff; border: 1px solid var(--line); border-radius: var(--r-sm);
    font-family: var(--display); font-weight: 700; font-size: 17px; color: var(--ink);
  }
  .letters a:hover { background: var(--ink); color: #fff; border-color: var(--ink); }

  .group { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 24px; padding: 28px 0; border-top: 2px solid var(--ink); scroll-margin-top: 90px; }
  .group h2 { font-size: 40px; color: var(--brand); }
  dl { margin: 0; }
  dl > div { padding: 0 0 18px; margin-bottom: 18px; border-bottom: 1px solid var(--line); scroll-margin-top: 90px; }
  dl > div:last-child { border-bottom: 0; margin-bottom: 0; }
  dl > div:target { background: var(--surface-2); outline: 8px solid var(--surface-2); }
  dt { font-family: var(--display); font-weight: 600; font-size: 21px; color: var(--ink); margin-bottom: 4px; }
  dd { margin: 0; font-size: 17px; line-height: 1.6; color: var(--ink-2); max-width: 75ch; }
  dd a { font-weight: 600; white-space: nowrap; }

  @media (max-width: 640px) {
    .group { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  }
</style>
