---
import Base from '../layouts/Base.astro';
import core from '../data/core.json';
import copy from '../data/copy.json';
import seo from '../data/seo.json';

const [title, description] = seo.about;
---

<Base title={title} description={description} path="/about">
  <section class="hero">
    <div class="wrap">
      <div class="kicker">About</div>
      <h1>Twenty-five years, same industry.</h1>
      <p class="lede">
        I didn't come to the car business from marketing. I came to marketing from the car
        business — and that changes everything about how I work.
      </p>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid grid-2 story">
      <div>
        <h2>The retail years</h2>
        <p>
          I spent years in retail sales and dealership operations. Walk-ins, phone ups, month-end
          pushes, trade appraisals, the whole thing. That's where I learned that the best-looking
          campaign in the world is worthless if the lead sits in the CRM for six hours.
        </p>
        <p>
          It also taught me how dealership people actually talk — which is why I don't write copy
          that sounds like a software company wrote it.
        </p>
      </div>
      <div>
        <h2>The digital years</h2>
        <p>
          Now I run digital for dealers: search, Google Business Profile, social, email,
          reputation, and the follow-up process that ties it together. Franchise stores and
          independents both — new-car rooftops and used-vehicle operations have very different
          problems, and I treat them that way.
        </p>
        <p>One person, accountable, on the phone when you call. That's the whole business model.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap section">
      <div class="kicker">The path</div>
      <h2>How I got here.</h2>
      <div class="timeline">
        {copy.timeline.map((entry) => (
          <div class="entry">
            <div class="when">{entry.when}</div>
            <h3>{entry.h}</h3>
            <p>{entry.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="kicker">What I believe</div>
    <h2>Four things I'd tell any dealer principal.</h2>
    <div class="grid grid-2 beliefs">
      {core.beliefs.map((belief) => (
        <div class="card">
          <h3>{belief.h}</h3>
          <p>{belief.p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section-tight">
    <div class="kicker">The practical stuff</div>
    <dl class="facts">
      {copy.personal.map((fact) => (
        <div>
          <dt>{fact.k}</dt>
          <dd>{fact.v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <div>
        <h2>Let's talk about your store.</h2>
        <p>Free audit, plain language, same business day reply.</p>
      </div>
      <a href="/contact" class="btn btn-dark">Contact Shawn</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(900px 460px at 78% 10%, var(--brand-tint) 0%, rgba(238, 241, 255, 0) 70%),
      var(--bg);
    border-bottom: 1px solid var(--line-2);
    padding: 62px 0 68px;
  }
  .hero .lede { max-width: 58ch; margin: 22px 0 0; }

  .story { gap: 56px; }
  .story h2 { font-size: 30px; margin-bottom: 18px; }
  .story p { font-size: 17px; line-height: 1.68; color: var(--ink-2); margin: 0 0 18px; text-wrap: pretty; }

  .band { background: var(--surface); border-block: 1px solid var(--line-2); }
  .timeline { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: 32px; }
  .entry { border-top: 2px solid var(--brand); padding-top: 18px; }
  .when { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--brand); margin-bottom: 10px; }
  .entry h3 { font-size: 18px; margin-bottom: 8px; }
  .entry p { font-size: 15px; line-height: 1.58; color: var(--ink-3); margin: 0; text-wrap: pretty; }

  .beliefs { margin-top: 30px; }
  .beliefs h3 { color: var(--brand); margin-bottom: 10px; }
  .beliefs p { font-size: 16px; line-height: 1.6; color: var(--ink-3); margin: 0; text-wrap: pretty; }

  .facts { margin: 26px 0 0; display: grid; gap: 1px; background: var(--line); border-block: 1px solid var(--line); }
  .facts > div { background: var(--bg); padding: 20px 0; display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 24px; align-items: baseline; }
  dt { font-size: 12.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  dd { margin: 0; font-size: 16.5px; line-height: 1.6; color: var(--ink-2); }

  .cta-band { background: var(--brand-tint); border-top: 1px solid var(--brand-line); }
  .cta-band .wrap {
    padding-top: 56px; padding-bottom: 56px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 40px; flex-wrap: wrap;
  }
  .cta-band h2 { font-size: 32px; margin-bottom: 10px; }
  .cta-band p { font-size: 16.5px; color: var(--ink-2); margin: 0; }

  @media (max-width: 900px) {
    .story { gap: 32px; }
    .timeline { grid-template-columns: minmax(0, 1fr); }
    .facts > div { grid-template-columns: minmax(0, 1fr); gap: 6px; }
  }
</style>
