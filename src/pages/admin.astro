---
// Staff-only CMS. Static shell — every byte of content is fetched in the
// browser under the signed-in user's RLS context, so an unauthenticated visitor
// who loads this page gets a login form and nothing else.
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin — Shawn Ryder Digital</title>
    <meta name="robots" content="noindex, nofollow" />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="admin">
    <div id="boot" class="state">Checking your session…</div>

    <section id="login" hidden>
      <div class="loginbox">
        <h1>Sign in</h1>
        <p class="sub">Staff access to leads, content and publishing.</p>
        <form id="login-form" novalidate>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="username" required />
          </label>
          <label>
            <span>Password</span>
            <input name="password" type="password" autocomplete="current-password" required />
          </label>
          <button type="submit" class="btn btn-primary">Sign in</button>
          <p class="status" role="status" aria-live="polite"></p>
        </form>
        <button type="button" id="forgot-link" class="linklike">Forgot password?</button>
        <form id="forgot-form" novalidate hidden>
          <label>
            <span>Email</span>
            <input name="email" type="email" autocomplete="username" required />
          </label>
          <button type="submit" class="btn btn-primary">Email me a reset link</button>
          <button type="button" id="forgot-cancel" class="linklike">Back to sign in</button>
          <p class="status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section id="reset" hidden>
      <div class="loginbox">
        <h1>Set a new password</h1>
        <p class="sub">You followed a reset link — choose a new password to finish.</p>
        <form id="reset-form" novalidate>
          <label>
            <span>New password</span>
            <input name="password" type="password" autocomplete="new-password" minlength="8" required />
          </label>
          <label>
            <span>Confirm new password</span>
            <input name="confirm" type="password" autocomplete="new-password" minlength="8" required />
          </label>
          <button type="submit" class="btn btn-primary">Save new password</button>
          <p class="status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <div id="app" hidden>
      <header class="topbar">
        <div class="brand">
          <span class="mark">SR</span>
          <strong>Admin</strong>
        </div>
        <div class="grow"></div>
        <div class="pubstate">
          <span id="pending" class="pill warn" hidden></span>
          <small id="lastpub"></small>
        </div>
        <button id="publish" class="btn btn-primary sm" hidden>Publish</button>
        <div class="who">
          <span id="who-email"></span>
          <span id="who-role" class="pill"></span>
        </div>
        <button id="signout" class="btn btn-ghost sm">Sign out</button>
      </header>

      <p id="readonly-note" class="note" hidden>
        Read-only access. You can see everything here but not change it — ask an admin.
      </p>

      <div class="layout">
        <nav id="snav" class="snav"></nav>
        <main id="section-body"></main>
      </div>
    </div>

    <div id="toast" class="toast"></div>

    <script>
      import { boot, signIn, sendPasswordReset, setNewPassword } from '../scripts/admin-app.js';

      boot();

      /** Wires a form to an async (values) => errorMessage|null handler. */
      function wireForm(form, handler, { onSuccess } = {}) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const status = form.querySelector('.status');
          const button = form.querySelector('button[type="submit"]');
          const data = new FormData(form);

          button.disabled = true;
          status.className = 'status';
          status.textContent = 'Working…';

          const error = await handler(data);

          if (error) {
            status.className = 'status bad';
            status.textContent = error;
            button.disabled = false;
            return;
          }
          if (onSuccess) onSuccess(status, button);
          else location.reload();
        });
      }

      wireForm(document.getElementById('login-form'), (data) =>
        signIn(String(data.get('email') || '').trim(), String(data.get('password') || '')));

      // ---- forgot password -------------------------------------------------
      const loginForm = document.getElementById('login-form');
      const forgotForm = document.getElementById('forgot-form');
      const forgotLink = document.getElementById('forgot-link');
      forgotLink.addEventListener('click', () => {
        // Carry the email over if they had already started typing it.
        forgotForm.email.value = loginForm.email.value;
        loginForm.hidden = true;
        forgotLink.hidden = true;
        forgotForm.hidden = false;
      });
      document.getElementById('forgot-cancel').addEventListener('click', () => {
        forgotForm.hidden = true;
        loginForm.hidden = false;
        forgotLink.hidden = false;
      });
      wireForm(forgotForm, (data) => sendPasswordReset(String(data.get('email') || '').trim()), {
        onSuccess: (status, button) => {
          // Deliberately vague about whether the address has an account —
          // confirming or denying that is an account-enumeration leak.
          status.className = 'status';
          status.textContent = 'If that address has an account, a reset link is on its way.';
          button.disabled = true;
        },
      });

      // ---- setting a new password after following the emailed link --------
      wireForm(document.getElementById('reset-form'), (data) => {
        const password = String(data.get('password') || '');
        const confirm = String(data.get('confirm') || '');
        if (password.length < 8) return Promise.resolve('Use at least 8 characters.');
        if (password !== confirm) return Promise.resolve('Those two passwords do not match.');
        return setNewPassword(password);
      }, {
        onSuccess: () => {
          // Clear the #type=recovery hash so a reload boots into the app
          // instead of showing this form again.
          history.replaceState(null, '', location.pathname);
          location.reload();
        },
      });
    </script>

    <style is:global>
      /* The [hidden] attribute must beat every author rule below. Several
         elements here carry their own display value — #login is grid, .btn is
         inline-block, .pill is inline-block — and an author selector outranks
         the browser's built-in [hidden] rule. Without this, hiding the login
         form after a successful sign-in left it on screen filling the viewport,
         with the signed-in admin pushed below the fold. */
      [hidden] { display: none !important; }

      body.admin { background: var(--bg); }
      .state, .loading { padding: 48px 28px; font-size: 16px; color: var(--muted); }

      /* ---------------------------------------------------------- login -- */
      #login, #reset { display: grid; place-items: center; min-height: 100vh; padding: 24px; }
      .loginbox {
        width: 100%; max-width: 380px;
        background: var(--surface); border: 1px solid var(--line);
        border-radius: 18px; padding: 32px 28px;
      }
      .loginbox h1 { font-size: 28px; }
      .loginbox .sub { font-size: 15px; color: var(--ink-3); margin: 8px 0 24px; }
      .loginbox form { display: grid; gap: 16px; }
      .linklike {
        display: block; margin-top: 14px; border: 0; background: none; cursor: pointer;
        font: inherit; font-size: 13.5px; color: var(--brand); padding: 0; text-align: left;
      }
      .linklike:hover { text-decoration: underline; }

      /* --------------------------------------------------------- shell -- */
      .topbar {
        position: sticky; top: 0; z-index: 20;
        display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
        padding: 14px 24px;
        background: rgba(250, 250, 251, 0.9); backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }
      .topbar .brand { display: flex; align-items: center; gap: 10px; }
      .topbar .mark {
        width: 28px; height: 28px; border-radius: 9px; background: var(--brand);
        display: grid; place-items: center;
        font-family: var(--display); font-weight: 800; font-size: 12px; color: #fff;
      }
      .topbar strong { font-family: var(--display); font-size: 16px; }
      .grow { flex: 1; }
      .pubstate { display: grid; gap: 3px; justify-items: end; text-align: right; }
      .pubstate small { font-size: 12px; color: var(--faint); }
      .who { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-3); }

      .note {
        margin: 16px 24px 0; padding: 12px 16px;
        background: var(--brand-tint); border: 1px solid var(--brand-line);
        border-radius: 12px; font-size: 14.5px; color: var(--ink-2);
      }

      .layout { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 28px; padding: 24px; }
      .snav { display: grid; gap: 3px; align-content: start; position: sticky; top: 84px; }
      .snav button {
        text-align: left; padding: 9px 14px; border-radius: 10px;
        border: 0; background: transparent; cursor: pointer;
        font-family: var(--display); font-weight: 600; font-size: 14.5px; color: var(--muted);
      }
      .snav button:hover { background: var(--surface-2); color: var(--ink); }
      .snav button.on { background: var(--brand-tint); color: var(--brand); }

      main { min-width: 0; }
      main h2 { font-size: 22px; margin: 28px 0 6px; }
      main h2:first-child { margin-top: 0; }
      .muted { font-size: 14.5px; color: var(--muted); margin: 0 0 18px; }

      /* --------------------------------------------------------- lists -- */
      .listhead { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
      .listhead .muted { margin: 0; flex: 1; }
      .search {
        width: 100%; margin-bottom: 14px; padding: 11px 14px;
        border: 1px solid var(--line); border-radius: 10px; background: var(--surface); font-size: 15px;
      }
      .cards { display: grid; gap: 8px; }
      .rowcard {
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        width: 100%; text-align: left; cursor: pointer;
        padding: 14px 18px; border: 1px solid var(--line); border-radius: 12px;
        background: var(--surface); font: inherit;
      }
      .rowcard:hover { border-color: var(--brand-line); }
      .rowcard strong { display: block; font-family: var(--display); font-size: 15.5px; }
      .rowcard small { display: block; margin-top: 3px; font-size: 13px; color: var(--faint); }

      .editorhead { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
      .back { border: 0; background: none; cursor: pointer; font: inherit; font-size: 14.5px; color: var(--brand); padding: 0; }
      .faqgroup { margin-bottom: 36px; }

      /* --------------------------------------------------------- forms -- */
      .fields { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
      .f { display: grid; gap: 6px; grid-column: span 4; }
      .f-sm { grid-column: span 2; }
      .f-xs { grid-column: span 1; }
      .f > span, .flabel {
        font-size: 12px; font-weight: 600; letter-spacing: 0.07em;
        text-transform: uppercase; color: var(--muted);
      }
      .f input[type='text'], .f input[type='number'], .f input[type='search'],
      .f textarea, .f select, .row input {
        width: 100%; padding: 10px 12px; font-size: 15px; color: var(--ink);
        border: 1px solid var(--line); border-radius: 10px; background: var(--surface); outline: none;
      }
      .f textarea { resize: vertical; line-height: 1.55; }
      .f textarea.mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 13.5px; line-height: 1.65;
      }
      .f input:focus, .f textarea:focus, .f select:focus, .row input:focus { border-color: var(--brand); }
      .f-check { grid-column: span 4; display: flex; align-items: center; gap: 10px; }
      .f-check input { width: 18px; height: 18px; accent-color: var(--brand); }
      .f-check span { text-transform: none; letter-spacing: 0; font-size: 15px; color: var(--ink); }
      .help { font-size: 12.5px; color: var(--faint); text-transform: none; letter-spacing: 0; }

      /* ---- Code section ---- */
      .muted.small { font-size: 13px; color: var(--faint); margin: -12px 0 14px; }
      .codenote {
        border: 1px solid var(--line); border-left: 3px solid var(--brand);
        border-radius: 10px; padding: 16px 18px; margin: 0 0 26px; background: var(--surface);
      }
      .codenote p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-2); }
      .codenote p.small { margin-top: 10px; font-size: 13px; color: var(--muted); }
      .codeblock { margin-bottom: 30px; }
      .codeblock h2 { margin-bottom: 4px; }
      textarea.code {
        width: 100%; padding: 12px 14px; resize: vertical;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 13px; line-height: 1.6; color: var(--ink);
        border: 1px solid var(--line); border-radius: 10px;
        background: var(--surface-2); outline: none;
        white-space: pre; overflow-wrap: normal; overflow-x: auto;
      }
      textarea.code:focus { border-color: var(--brand); }
      .codestat { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 10px; }
      .codestat .pill {
        padding: 3px 10px; border-radius: 999px;
        font-size: 11.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
      }
      .codestat .pill.ok { background: #e7f7f1; color: #0a7f5a; }
      .codestat .pill.bad { background: #fdf0ec; color: #b4482a; }
      .codestat .pill.off { background: var(--surface-2); color: var(--faint); }
      .codestat .chars { font-size: 12.5px; color: var(--faint); }
      .codestat p { flex-basis: 100%; margin: 0; font-size: 13.5px; line-height: 1.55; }
      .codestat .cerr { color: #b4482a; }
      .codestat .cwarn { color: #8a6410; }
      .codestat .cok { color: var(--faint); }

      .listbox { display: grid; gap: 8px; }
      .rows { display: grid; gap: 6px; }
      .row { display: flex; gap: 6px; align-items: center; }
      .icon {
        flex: 0 0 auto; width: 32px; height: 36px; cursor: pointer;
        border: 1px solid var(--line); border-radius: 8px; background: var(--surface);
        font-size: 14px; color: var(--muted);
      }
      .icon:hover { border-color: var(--ink); color: var(--ink); }
      .icon.danger { width: auto; padding: 0 10px; }
      .icon.danger:hover { border-color: #c0392b; color: #c0392b; }
      .add {
        justify-self: start; padding: 8px 14px; cursor: pointer;
        border: 1px dashed var(--line); border-radius: 999px; background: transparent;
        font-family: var(--display); font-weight: 600; font-size: 13.5px; color: var(--brand);
      }
      .add:hover { border-color: var(--brand); }

      .rep { display: grid; gap: 10px; }
      .repcard { border: 1px solid var(--line); border-radius: 12px; background: var(--surface); overflow: hidden; }
      .rephead {
        display: flex; align-items: center; gap: 6px;
        padding: 8px 10px 8px 14px; background: var(--surface-2); border-bottom: 1px solid var(--line);
      }
      .repnum {
        flex: 1; font-size: 12px; font-weight: 600; letter-spacing: 0.07em;
        text-transform: uppercase; color: var(--muted);
      }
      .repbody { padding: 16px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }

      /* -------------------------------------------------------- tables -- */
      .scroll { overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; background: var(--surface); border-radius: 12px; }
      th, td { text-align: left; padding: 13px 15px; border-bottom: 1px solid var(--line-2); vertical-align: top; }
      th { font-size: 11.5px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--faint); white-space: nowrap; }
      td { font-size: 14px; color: var(--ink-2); }
      td small { display: block; margin-top: 3px; font-size: 12.5px; color: var(--faint); }
      .nowrap { white-space: nowrap; }
      .notes { max-width: 340px; }
      .ticks { margin: 8px 0 0; padding-left: 15px; }
      .ticks li { font-size: 12.5px; color: var(--muted); }

      .pill {
        display: inline-block; padding: 4px 10px; border-radius: 999px;
        background: var(--surface-2); border: 1px solid var(--line);
        font-size: 12px; font-weight: 600; color: var(--ink-2);
      }
      .pill.ok { background: #e7f7f1; border-color: #b6e6d4; color: #0a7f5a; }
      .pill.warn { background: #fdf0ec; border-color: #f6cfc2; color: #b4482a; }
      .pill-select {
        padding: 5px 9px; border-radius: 999px; border: 1px solid var(--line);
        background: var(--bg); font-size: 12.5px; font-weight: 600; color: var(--ink-2);
      }

      /* ------------------------------------------------------- images -- */
      .gallery {
        display: grid; gap: 14px;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      }
      .mediacard {
        margin: 0; border: 1px solid var(--line); border-radius: 12px;
        background: var(--surface); overflow: hidden;
      }
      .mediacard > img {
        width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block;
        background: var(--surface-2);
      }
      .mediacard figcaption { padding: 10px; display: grid; gap: 7px; }
      .mediacard input {
        width: 100%; padding: 7px 9px; font-size: 13px;
        border: 1px solid var(--line); border-radius: 8px; background: var(--bg);
      }
      .mediacard small { font-size: 12px; color: var(--faint); }
      .mediacard .icon.danger { width: auto; height: 30px; justify-self: start; }

      .slotcard {
        display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 16px;
        align-items: center; padding: 14px;
        border: 1px solid var(--line); border-radius: 12px; background: var(--surface);
      }
      .slotpic {
        aspect-ratio: 4 / 3; border-radius: 8px; overflow: hidden;
        background: var(--surface-2); display: grid; place-items: center;
      }
      .slotpic img { width: 100%; height: 100%; object-fit: cover; }
      .slotmeta { display: grid; gap: 7px; }
      .slotmeta strong { font-family: var(--display); font-size: 15.5px; }
      .slotmeta small { font-size: 12.5px; color: var(--faint); }
      .slotmeta select {
        padding: 8px 10px; font-size: 14px; border: 1px solid var(--line);
        border-radius: 8px; background: var(--bg); max-width: 460px;
      }
      .nopic { font-size: 12.5px; color: var(--faint); }

      .imgpreview {
        max-width: 320px; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden;
        background: var(--surface-2); display: grid; place-items: center;
        border: 1px solid var(--line);
      }
      .imgpreview img { width: 100%; height: 100%; object-fit: cover; }

      /* ---- "Generate with AI" panel (admin-imagegen.js) ---- */
      .imagegen-wrap { margin-top: 4px; }
      .imagegen {
        margin-top: 10px; padding: 14px 16px;
        border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2);
        display: grid; gap: 10px; max-width: 460px;
      }
      .imagegen-label {
        display: grid; gap: 6px;
        font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
        color: var(--muted);
      }
      .imagegen-actions { display: flex; gap: 8px; flex-wrap: wrap; }
      .imagegen-preview {
        width: 100%; max-height: 260px; object-fit: contain;
        border-radius: 8px; background: var(--bg); border: 1px solid var(--line);
      }
      .imagegen .cerr, .imagegen p.cerr { margin: 0; font-size: 13.5px; color: #b4482a; }
      .imagegen .muted.small { margin: 0; font-size: 12.5px; }

      /* ---- AI helpers section (outlines, emails) ---- */
      .ai-helpers-section {
        margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--line);
      }
      .ai-helpers-section h3 { font-size: 18px; margin-bottom: 16px; color: var(--brand); }
      .ai-helpers-grid {
        display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
      }
      .ai-helper-box {
        border: 1px solid var(--line); border-radius: 12px; padding: 18px;
        background: var(--surface-2);
      }
      .ai-helper-box h4 { margin: 0 0 14px; font-size: 15px; }

      /* Outline generator */
      .outline-generator { display: grid; gap: 12px; }
      .outline-controls { display: flex; gap: 10px; flex-wrap: wrap; align-items: start; }
      .outline-status { font-size: 13px; color: var(--muted); }
      .outline-display { display: grid; gap: 10px; }
      .outline-item {
        border: 1px solid var(--line); border-radius: 8px; padding: 12px;
        background: var(--surface);
      }
      .outline-item h3 { margin: 0 0 8px; font-size: 14px; }
      .outline-item ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; font-size: 13.5px; }
      .outline-insert-btn {
        margin-top: 10px; padding: 6px 12px; font-size: 12px;
        background: var(--brand-tint); color: var(--brand); border: 1px solid var(--brand-line);
        border-radius: 6px; cursor: pointer;
      }
      .outline-insert-btn:hover { background: var(--brand); color: white; }
      .outline-raw { font-size: 12px; overflow-x: auto; }

      /* Email generator */
      .email-generator { display: grid; gap: 12px; }
      .email-controls { display: flex; gap: 10px; flex-wrap: wrap; align-items: start; }
      .scenario-select { padding: 8px 10px; font-size: 14px; border: 1px solid var(--line); border-radius: 8px; }
      .email-status { font-size: 13px; color: var(--muted); }
      .email-display { display: grid; gap: 12px; max-height: 600px; overflow-y: auto; }
      .email-sequence-header { margin-bottom: 4px; }
      .email-sequence-header h4 { margin: 0; font-size: 14px; }
      .email-card {
        border: 1px solid var(--line); border-radius: 8px; padding: 12px;
        background: var(--surface); display: grid; gap: 8px;
      }
      .email-timing { font-size: 12px; font-weight: 600; color: var(--brand); text-transform: uppercase; }
      .email-subject { font-size: 13px; font-weight: 600; color: var(--ink); }
      .email-body { font-size: 13.5px; line-height: 1.5; color: var(--ink-2); white-space: pre-wrap; word-wrap: break-word; }
      .email-copy-btn {
        align-self: start; padding: 6px 12px; font-size: 12px;
        background: var(--brand-tint); color: var(--brand); border: 1px solid var(--brand-line);
        border-radius: 6px; cursor: pointer;
      }
      .email-copy-btn:hover { background: var(--brand); color: white; }
      .email-raw { font-size: 12px; overflow-x: auto; }

      .btn-small {
        padding: 8px 14px; font-size: 13px; font-weight: 600;
        background: var(--brand); color: white; border: none; border-radius: 6px;
        cursor: pointer;
      }
      .btn-small:hover { opacity: 0.9; }
      .btn-small:disabled { opacity: 0.6; cursor: not-allowed; }

      .warnbar {
        margin-bottom: 16px; padding: 14px 18px;
        background: #fdf0ec; border: 1px solid #f6cfc2; border-radius: 12px;
        font-size: 14.5px; color: #7c3520; line-height: 1.55;
      }
      .warnbar strong { font-family: var(--display); }
      .warnbar code {
        display: inline-block; margin-top: 6px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 12.5px; background: rgba(0,0,0,.06); padding: 2px 6px; border-radius: 5px;
      }

      /* ----------------------------------------------------- insights -- */
      .statrow {
        display: grid; gap: 12px; margin-bottom: 28px;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      }
      .statcard {
        background: var(--surface); border: 1px solid var(--line);
        border-radius: 14px; padding: 18px 20px; display: grid; gap: 4px;
      }
      .statcard strong {
        font-family: var(--display); font-weight: 800; font-size: 30px;
        letter-spacing: -0.03em; color: var(--brand); line-height: 1;
      }
      .statcard span { font-size: 13.5px; color: var(--muted); }

      .insight { margin-bottom: 34px; }
      .bars { display: grid; gap: 8px; }
      .barrow {
        display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr) 40px;
        gap: 12px; align-items: center;
      }
      .barlabel {
        font-size: 13.5px; color: var(--ink-2);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .bartrack { height: 10px; background: var(--surface-2); border-radius: 999px; overflow: hidden; }
      .barfill { display: block; height: 100%; background: var(--brand); border-radius: 999px; }
      .barrow strong { font-size: 13.5px; text-align: right; color: var(--ink-2); }

      .spark {
        display: flex; align-items: flex-end; gap: 6px; height: 130px;
        padding: 12px; background: var(--surface);
        border: 1px solid var(--line); border-radius: 14px;
      }
      .sparkcol { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; gap: 6px; }
      .sparkbar { background: var(--brand); border-radius: 4px 4px 0 0; min-height: 2px; }
      .sparkcol small { font-size: 10.5px; color: var(--faint); text-align: center; }

      @media (max-width: 700px) {
        .barrow { grid-template-columns: minmax(0, 1fr) 40px; }
        .bartrack { display: none; }
      }

      .empty {
        background: var(--surface); border: 1px dashed var(--line); border-radius: 14px;
        padding: 32px 26px; font-size: 15.5px; color: var(--ink-3);
      }

      .btn.sm { padding: 9px 16px; font-size: 14px; border: 0; }
      .btn.sm.btn-ghost { border: 1px solid var(--line); }
      .btn.sm.danger { color: #c0392b; }
      .status { margin: 0; font-size: 14px; }
      .status:empty { display: none; }
      .status.bad { color: #c0392b; }

      .toast {
        position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 20px);
        padding: 12px 20px; border-radius: 999px;
        font-size: 14.5px; font-weight: 600; color: #fff; background: #0a7f5a;
        opacity: 0; pointer-events: none; transition: opacity 0.18s, transform 0.18s; z-index: 60;
      }
      .toast.bad { background: #c0392b; }
      .toast.show { opacity: 1; transform: translate(-50%, 0); }

      @media (max-width: 900px) {
        .layout { grid-template-columns: minmax(0, 1fr); }
        .snav { position: static; grid-auto-flow: column; overflow-x: auto; }
        .fields, .repbody { grid-template-columns: minmax(0, 1fr); }
        .f-sm, .f-xs { grid-column: span 1; }
      }
    </style>
  </body>
</html>
