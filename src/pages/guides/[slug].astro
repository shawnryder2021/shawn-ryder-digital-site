---
import Base from '../../layouts/Base.astro';
import { getGuides, getImageSlots } from '../../lib/content.js';
import { tools } from '../../lib/tools.js';
import { renderMarkdown, blocksToMarkdown } from '../../lib/markdown.js';
import { site } from '../../lib/site.js';

// Every guide gets a URL. Ones without a written body render an honest
// "not published yet" state rather than a thin page pretending otherwise —
// and they are excluded from the sitemap (see src/pages/sitemap.xml.js).
export async function getStaticPaths() {
  const guides = await getGuides();
  return guides
    .filter((g) => g.slug)
    .map((guide) => ({ params: { slug: guide.slug }, props: { guide, guides } }));
}

const { guide, guides } = Astro.props;

// Body may arrive as Markdown (CMS) or as the prototype's block array (JSON
// fallback). Normalise to Markdown, then render once.
const markdown = guide.body || blocksToMarkdown(guide.blocks ?? []);
const bodyHtml = renderMarkdown(markdown);
const takeaways = guide.takeaways ?? [];

// The free tool that puts a number on what this guide is about.
const TOOL_FOR_CATEGORY = {
  'Local SEO': '/google-profile-checkup',
  'Follow-up': '/lead-leak-calculator',
  Reputation: '/review-calculator',
  Email: '/sales-goal-calculator',
  Paid: '/ad-budget-planner',
  Website: '/search-preview-checker',
  Measurement: '/tracking-link-builder',
  Social: '/scorecard',
  AI: '/ai-visibility-check',
};
const TOOL_FOR_GUIDE = {
  'schema-markup-for-dealership-websites': '/dealer-schema-generator',
  'ranking-for-used-cars-near-me': '/local-keyword-planner',
  'inventory-pages-that-rank': '/local-keyword-planner',
  'car-dealership-seo-atlantic-canada': '/local-keyword-planner',
};
const tool = tools.find((t) => t.href === (TOOL_FOR_GUIDE[guide.slug] ?? TOOL_FOR_CATEGORY[guide.category]));
const portrait = (await getImageSlots()).about_portrait;

// Several guide headlines are long on their own. Only brand the title when the
// suffix still fits inside the ~70 characters Google renders.
const branded = `${guide.title} | ${site.name}`;
const pageTitle = branded.length <= 70 ? branded : guide.title;

const related = (() => {
  const sameCategory = guides.filter(
    (g) => g.slug !== guide.slug && g.category === guide.category && g.published
  );
  const filler = guides.filter((g) => g.slug !== guide.slug && g.published);
  return [...new Set([...sameCategory, ...filler])].slice(0, 3);
})();

const schema = bodyHtml
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: guide.title,
      description: guide.excerpt,
      articleSection: guide.category,
      datePublished: guide.date,
      url: `${site.url}/guides/${guide.slug}`,
      author: { '@id': `${site.url}/#shawn` },
      publisher: { '@id': `${site.url}/#business` },
      ...(guide.cover && {
        image: {
          '@type': 'ImageObject',
          url: guide.cover.url,
          width: guide.cover.width,
          height: guide.cover.height,
        },
      }),
    }
  : null;

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: 'Guides', url: '/guides' },
  { label: guide.category, url: `/guides?category=${encodeURIComponent(guide.category)}` },
  { label: guide.title, url: `/guides/${guide.slug}` },
];
---

<Base
  title={pageTitle}
  description={guide.excerpt}
  path={`/guides/${guide.slug}`}
  ogType="article"
  schema={schema}
  breadcrumbs={breadcrumbs}
  ogImage={guide.cover?.url}
>
  <article>
    <header class="head">
      <div class="wrap">
        <p class="crumb"><a href="/guides">Guides</a> / {guide.category}</p>
        <h1>{guide.title}</h1>
        <p class="lede">{guide.excerpt}</p>
        <div class="meta">
          <span>{guide.category}</span>
          <span>{guide.read}</span>
          <span>{guide.date}</span>
        </div>
      </div>
    </header>

    {guide.cover && (
      <div class="wrap">
        <div class="cover">
          <img
            src={guide.cover.url}
            alt={guide.cover.alt}
            width={guide.cover.width}
            height={guide.cover.height}
            fetchpriority="high"
          />
        </div>
      </div>
    )}

    {takeaways.length > 0 && (
      <div class="wrap">
        <aside class="takeaways">
          <div class="kicker">What you'll walk away with</div>
          <ul>
            {takeaways.map((t) => <li>{t}</li>)}
          </ul>
        </aside>
      </div>
    )}

    {bodyHtml ? (
      <div class="wrap">
        <div class="body" set:html={bodyHtml} />

        {tool && (
          <a class="toolbox" href={tool.href}>
            <span class="tb-label">Free tool · {tool.time}</span>
            <strong>{tool.name}</strong>
            <span class="tb-blurb">{tool.blurb}</span>
            <span class="tb-go">Open the tool ›</span>
          </a>
        )}

        <aside class="author">
          {portrait
            ? <img src={portrait.url} alt={portrait.alt} width="72" height="72" loading="lazy" />
            : <span class="mono" aria-hidden="true">SR</span>}
          <div>
            <span class="a-label">Written by</span>
            <strong>Shawn Ryder</strong>
            <p>
              Twenty-five years in the car business — retail sales and dealership operations before
              digital. I work with franchise and independent dealers across Canada and the U.S.,
              from Halifax, Nova Scotia.
            </p>
            <p class="a-links"><a href="/about">More about Shawn</a> · <a href="/sample-audit">See a sample audit</a> · <a href="/contact">Ask a question</a></p>
          </div>
        </aside>
      </div>
    ) : (
      <div class="wrap">
        <div class="unwritten">
          <h2>This one isn't written yet.</h2>
          <p>
            It's on the list. If it's the one you need, say so and I'll move it up — or just ask
            me the question directly and skip the article.
          </p>
          <a href="/contact" class="btn btn-primary">Ask me instead</a>
        </div>
      </div>
    )}
  </article>

  {related.length > 0 && (
    <section class="wrap section-tight related">
      <h2 class="small">Read next</h2>
      <div class="grid grid-3">
        {related.map((g) => (
          <a class="card" href={`/guides/${g.slug}`}>
            <div class="tag">{g.category} · {g.read}</div>
            <h3>{g.title}</h3>
            <p>{g.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="cta-band">
    <div class="wrap">
      <div>
        <h2>Rather have me just do it?</h2>
        <p>Free audit of your website, Google profile, reviews and follow-up. Plain language, no pitch deck.</p>
      </div>
      <a href="/contact" class="btn btn-dark">Request the audit</a>
    </div>
  </section>
</Base>

<style>
  .head {
    background: var(--surface);
    border-bottom: 1px solid var(--line-2);
    padding: 52px 0 46px;
  }
  .crumb { font-size: 14px; color: var(--faint); margin: 0 0 18px; }
  .head h1 { font-size: 46px; max-width: 28ch; }
  .head .lede { max-width: 62ch; margin: 20px 0 0; }
  .meta {
    display: flex; gap: 10px; flex-wrap: wrap;
    margin-top: 24px; font-size: 13.5px; font-weight: 600; color: var(--muted);
  }
  .meta span { background: var(--surface-2); border-radius: var(--r-sm); padding: 7px 14px; }

  .cover {
    max-width: 74ch;
    margin: 36px 0 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; }

  .takeaways {
    max-width: 74ch;
    margin: 40px 0 0;
    background: var(--brand-tint);
    border: 1px solid var(--brand-line);
    border-radius: var(--radius);
    padding: 26px 28px;
  }
  .takeaways ul { margin: 0; padding-left: 20px; display: grid; gap: 9px; }
  .takeaways li { font-size: 16px; line-height: 1.55; color: var(--ink-2); }

  /* The body arrives via set:html, which Astro does not tag with the scoping
     attribute — so everything below .body has to be :global() or it never
     applies. Left-aligned to sit flush with the cover and takeaways above. */
  .body { max-width: 74ch; padding-top: 40px; padding-bottom: 36px; }
  .body :global(h2) { font-size: 30px; margin: 44px 0 16px; }
  .body :global(h3) { font-size: 22px; margin: 32px 0 12px; }
  .body :global(p) { font-size: 18px; line-height: 1.72; color: var(--ink-2); margin: 0 0 20px; text-wrap: pretty; }
  .body :global(ul), .body :global(ol) { margin: 0 0 24px; padding-left: 22px; display: grid; gap: 12px; }
  .body :global(li) { font-size: 17.5px; line-height: 1.65; color: var(--ink-2); text-wrap: pretty; }
  .body :global(strong) { color: var(--ink); }
  .body :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .body :global(img) { border-radius: var(--radius); margin: 28px 0; }
  .body :global(blockquote) {
    margin: 34px 0;
    padding: 4px 0 4px 26px;
    border-left: 3px solid var(--brand);
    font-family: var(--display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .body :global(blockquote p) { font-size: inherit; color: inherit; margin: 0; line-height: inherit; }

  .toolbox {
    display: grid; gap: 4px; max-width: 74ch; margin: 0 0 28px; padding: 22px 24px;
    background: #fff; border: 1px solid var(--line); border-left: 6px solid var(--brand);
    border-radius: var(--radius); color: inherit;
  }
  .toolbox:hover { box-shadow: var(--shadow-md); color: inherit; }
  .tb-label { font-family: var(--display); font-size: 13.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .toolbox strong { font-family: var(--display); font-weight: 600; font-size: 23px; color: var(--ink); }
  .toolbox:hover strong { color: var(--brand); }
  .tb-blurb { font-size: 16px; line-height: 1.55; color: var(--ink-3); }
  .tb-go { font-family: var(--display); font-weight: 600; font-size: 16px; color: var(--brand); margin-top: 6px; }

  .author {
    display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 20px; max-width: 74ch;
    padding: 26px 0 56px; border-top: 2px solid var(--ink);
  }
  .author img, .mono { width: 72px; height: 72px; border-radius: var(--r-sm); object-fit: cover; }
  .mono {
    background: var(--navy); color: #fff; display: grid; place-items: center;
    font-family: var(--display); font-weight: 700; font-size: 26px; box-shadow: inset 0 -4px 0 var(--brand);
  }
  .a-label { display: block; font-family: var(--display); font-size: 13.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .author strong { font-family: var(--display); font-weight: 600; font-size: 22px; }
  .author p { font-size: 16px; line-height: 1.6; color: var(--ink-2); margin: 6px 0 0; }
  .a-links { font-weight: 600; }

  .unwritten {
    max-width: 62ch;
    margin: 56px 0;
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    padding: 40px 34px;
  }
  .unwritten h2 { font-size: 28px; margin-bottom: 14px; }
  .unwritten p { font-size: 17px; line-height: 1.65; color: var(--ink-3); margin: 0 0 26px; }

  .related { border-top: 1px solid var(--line-2); }
  h2.small { font-size: 26px; margin-bottom: 22px; }
  .card .tag { font-size: 13px; font-weight: 600; color: var(--brand); margin-bottom: 12px; }
  .card h3 { margin-bottom: 10px; }
  .card p { font-size: 15.5px; line-height: 1.6; color: var(--ink-3); margin: 0; }

  .cta-band { background: var(--brand-tint); border-top: 1px solid var(--brand-line); }
  .cta-band .wrap {
    padding-top: 56px; padding-bottom: 56px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 40px; flex-wrap: wrap;
  }
  .cta-band h2 { font-size: 32px; margin-bottom: 10px; }
  .cta-band p { font-size: 16.5px; color: var(--ink-2); margin: 0; max-width: 56ch; }

  @media (max-width: 900px) {
    .head h1 { font-size: 34px; }
    .body :global(h2) { font-size: 25px; }
    .body :global(p) { font-size: 17px; }
  }
</style>
