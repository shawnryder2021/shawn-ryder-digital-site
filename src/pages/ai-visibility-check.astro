---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site.js';

const title = 'Check What AI Says About Your Dealership | Shawn Ryder Digital';
const description =
  "Type your store name and city, and see what an AI assistant actually tells a shopper about you — including whether it knows you exist. Free, no email required.";
---

<Base title={title} description={description} path="/ai-visibility-check">
  <section class="hero">
    <div class="wrap">
      <div class="kicker light">Free tool</div>
      <h1>What does AI say about your dealership?</h1>
      <p class="lede">
        Shoppers are asking assistants which dealer to trust before they ever reach your website.
        Put your store in below and see the answer they get — including whether the assistant
        knows you exist at all.
      </p>

      <form id="vis-form" novalidate>
        <div class="row">
          <label>
            <span>Dealership name</span>
            <input name="dealership" type="text" placeholder="e.g. Whitfield Motors" required />
            <small class="err" data-for="dealership"></small>
          </label>
          <label>
            <span>City</span>
            <input name="city" type="text" placeholder="e.g. Halifax" required />
            <small class="err" data-for="city"></small>
          </label>
        </div>
        <div class="hp" aria-hidden="true">
          <label>Company website<input name="company_website" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="btn btn-primary">Run the check</button>
        <p class="note">Takes about ten seconds. No email needed to see the result.</p>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="wrap section" id="results" hidden>
    <div class="verdict" id="verdict"></div>
    <div id="answers" class="answers"></div>

    <div class="after">
      <h2>What this actually tells you</h2>
      <p>
        This is one assistant, answering cold, with no web browsing — which is roughly what a
        shopper gets when they ask about a store the model has never had good information about.
        If the answer above was vague, hedged, or about a different business entirely, that is
        the gap. It is fixable, and it is mostly not about ads.
      </p>
      <a href="/ai-search-visibility" class="btn btn-ghost">How this gets fixed →</a>
      <a href="/contact" class="btn btn-primary">Get a full baseline across every assistant</a>
    </div>
  </section>

  <section class="wrap section-tight">
    <div class="grid grid-3">
      <div class="card">
        <h3>Why the answer is often wrong</h3>
        <p>Assistants assemble answers from what they can read: your site, your Google profile, directories, reviews. If those disagree, the model hedges — or picks a competitor it is more sure about.</p>
      </div>
      <div class="card">
        <h3>Why it matters now</h3>
        <p>There is no ad inventory to buy in an AI answer. Being named is earned through structure, consistency and real review sentiment — which takes months, so starting late is expensive.</p>
      </div>
      <div class="card">
        <h3>What a full baseline covers</h3>
        <p>The same shopper prompts run across the major assistants, recorded verbatim, with the fixes ranked by what shifts the answer fastest. That one is a person doing it, not this tool.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('vis-form');
  const status = form.querySelector('.status');
  const button = form.querySelector('button');
  const results = document.getElementById('results');
  const verdict = document.getElementById('verdict');
  const answers = document.getElementById('answers');

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    form.querySelectorAll('.err').forEach((e) => { e.textContent = ''; });
    status.className = 'status';
    status.textContent = '';

    const data = new FormData(form);
    button.disabled = true;
    button.textContent = 'Asking…';

    try {
      const res = await fetch('/api/visibility-check', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          dealership: data.get('dealership') || '',
          city: data.get('city') || '',
          company_website: data.get('company_website') || '',
        }),
      });
      const body = await res.json().catch(() => ({}));

      if (!res.ok || !body.ok) {
        if (body.details) {
          for (const [field, message] of Object.entries(body.details)) {
            const el = form.querySelector(`.err[data-for="${field}"]`);
            if (el) el.textContent = message;
          }
        }
        status.className = 'status bad';
        status.textContent = body.error || 'That did not go through. Please try again.';
        return;
      }

      verdict.className = `verdict ${body.mentioned ? 'known' : 'unknown'}`;
      verdict.innerHTML = body.mentioned
        ? `<strong>The assistant named ${esc(body.dealership)}.</strong>
           <p>Read what it said carefully — being mentioned is not the same as being described
           accurately. Wrong hours, wrong brands or a lukewarm summary all cost you the same
           shopper.</p>`
        : `<strong>The assistant could not tell a shopper anything useful about ${esc(body.dealership)}.</strong>
           <p>It either did not recognise the store or steered the shopper somewhere else. That is
           the most common result, and it is the problem worth fixing.</p>`;

      answers.innerHTML = body.results.map((r) => `
        <article class="answer">
          <div class="q">${esc(r.prompt)}</div>
          <div class="a">${esc(r.answer).replace(/\n/g, '<br>')}</div>
          <div class="tag ${r.mentioned ? 'yes' : 'no'}">
            ${r.mentioned ? 'Named your store' : 'Did not name your store'}
          </div>
        </article>`).join('');

      results.hidden = false;
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch {
      status.className = 'status bad';
      status.textContent = 'Could not reach the checker. Please try again shortly.';
    } finally {
      button.disabled = false;
      button.textContent = 'Run the check';
    }
  });
</script>

<style>
  [hidden] { display: none !important; }

  .hero { background: var(--ink); color: #fff; padding: 64px 0 68px; }
  .hero h1 { color: #fff; max-width: 18ch; }
  .hero .lede { color: #b9bcc2; max-width: 58ch; margin: 22px 0 34px; }
  .kicker.light { color: #9fb0ff; }

  form { max-width: 620px; }
  .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  label { display: grid; gap: 7px; }
  label > span {
    font-size: 12.5px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: #9aa0af;
  }
  input[type='text'] {
    width: 100%; padding: 14px 16px; font-size: 16px;
    border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 12px;
    background: rgba(255, 255, 255, 0.06); color: #fff; outline: none;
  }
  input::placeholder { color: #7b8090; }
  input:focus { border-color: var(--brand); background: rgba(255, 255, 255, 0.1); }
  button { margin-top: 18px; border: 0; }
  button[disabled] { opacity: 0.65; cursor: progress; }
  .note { font-size: 13.5px; color: #8b90a0; margin: 12px 0 0; }
  .err { color: #ff9b8a; font-size: 13px; }
  .status { margin: 12px 0 0; font-size: 15px; }
  .status:empty { display: none; }
  .status.bad { color: #ff9b8a; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .verdict {
    border-radius: 18px; padding: 26px 28px; margin-bottom: 22px;
    border: 1px solid var(--line); background: var(--surface);
  }
  .verdict.known { border-color: #b6e6d4; background: #f2fbf7; }
  .verdict.unknown { border-color: #f6cfc2; background: #fdf6f3; }
  .verdict strong { display: block; font-family: var(--display); font-size: 21px; margin-bottom: 8px; }
  .verdict p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--ink-2); max-width: 70ch; }

  .answers { display: grid; gap: 14px; }
  .answer {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 16px; padding: 22px 24px;
  }
  .answer .q {
    font-family: var(--display); font-weight: 700; font-size: 15.5px;
    color: var(--brand); margin-bottom: 12px;
  }
  .answer .a { font-size: 16px; line-height: 1.65; color: var(--ink-2); }
  .answer .tag {
    display: inline-block; margin-top: 14px; padding: 5px 12px; border-radius: 999px;
    font-size: 12.5px; font-weight: 600;
  }
  .answer .tag.yes { background: #e7f7f1; color: #0a7f5a; }
  .answer .tag.no { background: #fdf0ec; color: #b4482a; }

  .after { margin-top: 34px; padding-top: 30px; border-top: 1px solid var(--line); }
  .after h2 { font-size: 26px; margin-bottom: 12px; }
  .after p { font-size: 16.5px; line-height: 1.65; color: var(--ink-2); max-width: 68ch; margin: 0 0 22px; }
  .after .btn { margin-right: 10px; }

  .card h3 { margin-bottom: 10px; font-size: 18px; }
  .card p { font-size: 15.5px; line-height: 1.6; color: var(--ink-3); margin: 0; }

  @media (max-width: 700px) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .after .btn { display: block; margin: 0 0 10px; }
  }
</style>
