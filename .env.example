# Copy to .env for local dev; set the same keys in Netlify under
# Site configuration → Environment variables.

# Supabase — the service role key bypasses RLS and must never reach the browser.
# It is only ever read inside netlify/functions/*.
SUPABASE_URL=https://ohuztdpbemmghwbgagfx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Activepieces webhook that receives every audit request and subscriber.
LEAD_WEBHOOK_URL=https://cloud.activepieces.com/api/v1/webhooks/3hD86xRwatf22FlhHqK4u

# Comma-separated origins allowed to POST to the form endpoints.
ALLOWED_ORIGINS=https://shawnryder.com,https://www.shawnryder.com

# Browser-side Supabase access for the /admin area. PUBLIC_ vars are embedded
# in the client bundle at build time — these two are meant to be public, and
# grant nothing on their own. RLS decides what a signed-in user can see.
PUBLIC_SUPABASE_URL=https://ohuztdpbemmghwbgagfx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_HRVq4NTg_-qQBurnIvabag_-vzetn2n

# Netlify build hook, created in Netlify → Build & deploy → Build hooks.
# The admin's Publish button POSTs here to rebuild the site with new content.
NETLIFY_BUILD_HOOK_URL=
